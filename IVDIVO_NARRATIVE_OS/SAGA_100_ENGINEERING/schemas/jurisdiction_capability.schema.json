{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ivdivo.local/saga100/schemas/jurisdiction_capability.schema.json",
  "title":"IVDIVO Saga100 Jurisdiction Capability Matrix",
  "type":"object",
  "additionalProperties":false,
  "required":["matrix_id","actors"],
  "properties":{
    "matrix_id":{"type":"string"},
    "actors":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["actor_id","actor_type","capabilities","jurisdiction","allowed_actions","prohibited_inferences","authority_refs"],"properties":{
      "actor_id":{"type":"string"},
      "actor_type":{"enum":["INDIVIDUAL","OES","PLANETARY_AUTHORITY","ORBITAL_AUTHORITY","CONFEDERATION_ADVISORY","CONFEDERATION_AUTHORITY","CIVIC_SYSTEM","OTHER"]},
      "capabilities":{"type":"array","items":{"type":"string"}},
      "jurisdiction":{"type":"array","items":{"type":"string"}},
      "allowed_actions":{"type":"array","items":{"type":"string"}},
      "forbidden_actions":{"type":"array","items":{"type":"string"}},
      "prohibited_inferences":{"type":"array","minItems":1,"items":{"type":"string"}},
      "authority_refs":{"type":"array","minItems":1,"items":{"type":"string"}}
    }}}
  }
}
