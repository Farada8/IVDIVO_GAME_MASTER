{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ivdivo.local/saga100/schemas/consequence_ledger.schema.json",
  "title":"IVDIVO Saga100 Consequence Ledger",
  "type":"object",
  "additionalProperties":false,
  "required":["ledger_id","entries"],
  "properties":{
    "ledger_id":{"type":"string"},
    "entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["consequence_id","source_project","category","statement","persistence","downstream_required","authority_status"],"properties":{
      "consequence_id":{"type":"string"},
      "source_project":{"type":"string"},
      "category":{"enum":["CHARACTER","RELATIONSHIP","INSTITUTION","LAW","TECHNOLOGY","ACCESS","JURISDICTION","HOUSING","WORK","INJURY","KNOWLEDGE","SECRET","CULTURE","ECONOMY","GEOGRAPHY","OTHER"]},
      "statement":{"type":"string","minLength":8},
      "persistence":{"enum":["PERMANENT","UNTIL_EXPLICIT_CHANGE","TEMPORARY_WITH_EXPIRY","UNKNOWN"]},
      "downstream_required":{"type":"boolean"},
      "authority_status":{"enum":["CANON","LOCKED","WORKING","OPTION","UNKNOWN","HOLD"]},
      "source_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
      "supersedes":{"type":"array","items":{"type":"string"}},
      "consumed_by":{"type":"array","items":{"type":"string"}}
    }}}
  }
}
