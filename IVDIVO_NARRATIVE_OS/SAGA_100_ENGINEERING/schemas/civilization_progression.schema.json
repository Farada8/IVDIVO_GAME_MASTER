{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ivdivo.local/saga100/schemas/civilization_progression.schema.json",
  "title":"IVDIVO Saga100 Civilization Progression Ledger",
  "type":"object",
  "additionalProperties":false,
  "required":["ledger_id","capabilities"],
  "properties":{
    "ledger_id":{"type":"string"},
    "capabilities":{"type":"array","items":{"$ref":"#/$defs/capability"}}
  },
  "$defs":{"capability":{"type":"object","additionalProperties":false,"required":["capability_id","name","current_stage","history","access_scope"],"properties":{
    "capability_id":{"type":"string","minLength":2},
    "name":{"type":"string","minLength":3},
    "current_stage":{"$ref":"#/$defs/stage"},
    "access_scope":{"type":"array","minItems":1,"items":{"type":"string"}},
    "history":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["from","to","evidence_refs","consequence_refs"],"properties":{"from":{"anyOf":[{"$ref":"#/$defs/stage"},{"type":"null"}]},"to":{"$ref":"#/$defs/stage"},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"consequence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"exception":{"type":"boolean","default":false},"exception_reason":{"type":["string","null"]}}}},
    "forbidden_inferences":{"type":"array","items":{"type":"string"}}
  }},
  "stage":{"enum":["EXISTS_ELSEWHERE","KNOWN","CONTACT_ACCESS","RESTRICTED_USE","LOCAL_PROTOTYPE","LEGALIZED_USE","SCALABLE_MANUFACTURE","ORDINARY_LIFE"]}}
}
