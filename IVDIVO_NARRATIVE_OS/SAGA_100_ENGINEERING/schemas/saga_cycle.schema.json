{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ivdivo.local/saga100/schemas/saga_cycle.schema.json",
  "title":"IVDIVO Saga100 SagaCycle",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","cycle_id","civilization_threshold","state","slots","crossing_dependencies","proof_obligations"],
  "properties":{
    "schema_version":{"type":"string"},
    "cycle_id":{"type":"string","pattern":"^S100-C(0[1-9]|1[0-9]|2[0-5])$"},
    "civilization_threshold":{"type":"object","additionalProperties":false,"required":["id","name","human_pain"],"properties":{"id":{"type":"string","pattern":"^T(0[1-9]|1[0-9]|2[0-5])$"},"name":{"type":"string","minLength":3},"human_pain":{"type":"string","minLength":10}}},
    "state":{"enum":["QUESTION_SELECTED","LINE_S_PLANNED","LINE_O_PLANNED","LINE_C_PLANNED","LINE_BOOKS_LOCALLY_CLOSED","CROSSING_ELIGIBLE","CROSSING_CLOSED","CIVILIZATION_DELTA_LOCKED","NEXT_CYCLE_ELIGIBLE","HOLD"]},
    "slots":{"type":"object","additionalProperties":false,"required":["S","O","C","X"],"properties":{"S":{"$ref":"#/$defs/slot"},"O":{"$ref":"#/$defs/slot"},"C":{"$ref":"#/$defs/slot"},"X":{"$ref":"#/$defs/slot"}}},
    "crossing_dependencies":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "proof_obligations":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "consequence_ledger_ref":{"type":["string","null"]},
    "authority_status":{"enum":["CANON","LOCKED_PROJECT_AUTHORITY","WORKING","OPTION","UNKNOWN","HOLD"]}
  },
  "$defs":{"slot":{"type":"object","additionalProperties":false,"required":["role","project_id","mapping_status","book_independence_status"],"properties":{"role":{"enum":["SMITH_OES","ORBITAL","CONFEDERATION_FRONTIER","CROSSING"]},"project_id":{"type":["string","null"]},"mapping_status":{"enum":["MAPPED","CANDIDATE","HOLD","UNKNOWN"]},"book_independence_status":{"enum":["PASS","FAIL","NOT_RUN","HOLD"]},"authority_ref":{"type":["string","null"]},"upstream_required":{"type":"array","items":{"type":"string"},"uniqueItems":true}}}}
}
