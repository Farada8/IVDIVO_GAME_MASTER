{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ivdivo.local/saga100/schemas/proof_manifest.schema.json",
  "title":"IVDIVO Saga100 Proof Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["proof_id","subject","authority_snapshot","obligations","evidence","result","regression_scope","persistence"],
  "properties":{
    "proof_id":{"type":"string","pattern":"^P_S100_[A-Z0-9_]+$"},
    "subject":{"type":"object","required":["type","id"],"properties":{"type":{"enum":["BOOK","CYCLE","CAPABILITY","MATRIX","SYSTEM_CANDIDATE"]},"id":{"type":"string"}}},
    "authority_snapshot":{"type":"array","minItems":1,"items":{"type":"object","required":["ref","status"],"properties":{"ref":{"type":"string"},"status":{"enum":["CANON","LOCKED","CURRENT","WORKING","OPTION","UNKNOWN","HOLD"]},"sha_or_revision":{"type":["string","null"]}}}},
    "obligations":{"type":"array","minItems":1,"items":{"type":"object","required":["id","statement","severity_if_fail"],"properties":{"id":{"type":"string"},"statement":{"type":"string"},"severity_if_fail":{"enum":["FATAL","MAJOR","MEDIUM","POLISH"]}}}},
    "evidence":{"type":"array","items":{"type":"object","required":["obligation_id","ref","finding"],"properties":{"obligation_id":{"type":"string"},"ref":{"type":"string"},"finding":{"type":"string"},"evidence_class":{"enum":["AUTHORITY","TEXT","MACHINE_TEST","HUMAN_EXTERNAL","INFERENCE"]}}}},
    "result":{"enum":["PASS","FAIL","HOLD","PARTIAL"]},
    "unresolved":{"type":"array","items":{"type":"string"}},
    "regression_scope":{"type":"array","items":{"type":"string"}},
    "persistence":{"type":"object","required":["github","drive_required","readback_status"],"properties":{"github":{"type":"string"},"drive_required":{"type":"boolean"},"drive_ref":{"type":["string","null"]},"readback_status":{"enum":["PASS","FAIL","NOT_RUN","NOT_REQUIRED"]}}}
  }
}
