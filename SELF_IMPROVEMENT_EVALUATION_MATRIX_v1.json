{
  "schema_version": "1.0",
  "updated": "2026-08-21",
  "status": "CURRENT_SELF_IMPROVEMENT_EVALUATION_CONTRACT",
  "purpose": "Define what evidence can justify claiming that a change improved books, audio, production performance or the engine itself. Prevent improvement-by-impression and evidence-class substitution.",
  "evidence_classes": [
    "STATIC_OR_SCHEMA_CONTRACT",
    "DETERMINISTIC_FIXTURE",
    "ADVERSARIAL_NEGATIVE_TEST",
    "INTERNAL_RED_TEAM",
    "INDEPENDENT_MODEL_REVIEW",
    "REAL_PROJECT_PILOT",
    "LIVE_PROVIDER_EVIDENCE",
    "HUMAN_READER_LISTENER_EVIDENCE",
    "MARKET_PLATFORM_EVIDENCE"
  ],
  "evidence_non_substitution_law": {
    "automated_tests_do_not_prove_literary_quality": true,
    "model_review_does_not_equal_human_signal": true,
    "dry_run_does_not_equal_live_provider": true,
    "source_inspection_does_not_equal_runtime_execution": true,
    "market_score_prediction_does_not_equal_market_behavior": true,
    "multiple_non_independent_models_do_not_equal_independent_evidence": true
  },
  "book_evaluation": {
    "primary": [
      "FATAL_COUNT",
      "MAJOR_COUNT",
      "MAIN_CONFLICT_COMPLETED_RESOLUTION",
      "PROTAGONIST_AGENCY_AND_CLIMAX_ACTION",
      "CAUSAL_CHAIN_INTEGRITY",
      "CHARACTER_SPECIFICITY_NOT_FUNCTIONALITY",
      "SCENE_STATE_DELTA_RATE",
      "DIALOGUE_OBJECTIVE_RESISTANCE_SUBTEXT_TURN",
      "CONTINUITY_INTEGRITY",
      "SOURCE_DISTANCE_ORIGINALITY"
    ],
    "secondary": [
      "REPAIR_CYCLES_TO_GREEN",
      "EXPOSITION_LORE_OVERLOAD",
      "P51_VOICE_DIFFERENTIATION",
      "P52_EMOTIONAL_RANGE",
      "P53_RELATIONSHIP_AUTHORITY_INTEGRITY",
      "READER_HOMEWORK_CONFUSION",
      "HOOK_PAYOFF_CADENCE"
    ],
    "external_only": [
      "HUMAN_P51_BLIND_SWAP",
      "REAL_READER_DROPOFF",
      "REAL_READER_CONTINUE_INTENT",
      "PUBLISHER_EDITOR_AGENT_FEEDBACK",
      "MARKET_COMPLETION_CONVERSION"
    ],
    "hard_rule": "WORD_COUNT_OR_MORE_LORE_IS_NOT_A_QUALITY_IMPROVEMENT_BY_ITSELF"
  },
  "audio_evaluation": {
    "primary": [
      "PROTECTED_TEXT_INTEGRITY",
      "VOICE_ROLE_FIT",
      "DIRECTION_CHANGE_RESPONSIVENESS",
      "PAIR_ENSEMBLE_FUNCTION",
      "LONG_FORM_FATIGUE",
      "PRONUNCIATION_IDENTITY_CONSISTENCY",
      "CLUE_CAUSAL_AND_MUSICAL_FACT_FIDELITY",
      "ALIGNMENT_TIMELINE_INTEGRITY",
      "MIX_MASTER_QC",
      "RELEASE_GATE_FATAL_MAJOR_ZERO"
    ],
    "secondary": [
      "RENDER_BLOCK_REGEN_RATIO",
      "PROVIDER_FAILURE_RATE",
      "MANUAL_REVIEW_DEFECT_RATE",
      "PREVENTABLE_CREDIT_COST_WASTE",
      "AUDIO_REPAIR_CYCLES"
    ],
    "external_only": [
      "REAL_HUMAN_LISTEN_COMPREHENSION",
      "REAL_HUMAN_EMOTIONAL_PERFORMANCE_JUDGMENT",
      "REAL_LISTENER_DROPOFF_RETENTION",
      "REAL_PLATFORM_COMPLETION_OR_CONVERSION"
    ],
    "hard_rule": "AUDIO_QUALITY_IMPROVEMENT_MAY_NOT_BE_BOUGHT_BY_SILENTLY_REWRITING_LOCKED_STORY"
  },
  "productivity_evaluation": {
    "primary": [
      "DUPLICATE_WORK_REDUCTION",
      "CONTEXT_RECONSTRUCTION_REDUCTION",
      "STALE_WRITE_OR_OVERWRITE_RATE",
      "UNNECESSARY_FULL_REGENERATION_RATE",
      "MANUAL_NUDGE_COUNT_FOR_ALREADY_DETERMINED_NEXT_STEPS",
      "CYCLE_TIME_TO_LEGITIMATE_GATE",
      "REWORK_CYCLES",
      "PROVIDER_COST_PER_ACCEPTED_OUTPUT",
      "SELECTIVE_REPAIR_RATIO",
      "SAFE_PARALLELISM_UTILIZATION"
    ],
    "quality_guard": "NO_PRODUCTIVITY_GAIN_COUNTS_IF_P0_P1_OR_P2_REGRESSES"
  },
  "engine_evaluation": {
    "primary": [
      "CONTRACT_TEST_PASS",
      "NEGATIVE_TEST_FAIL_CLOSED",
      "FALSE_GREEN_RATE",
      "REGRESSION_SURVIVAL",
      "STATE_RESUME_INTEGRITY",
      "CONCURRENT_REBASE_INTEGRITY",
      "ROLLBACK_INTEGRITY",
      "SELECTIVE_DESCENDANT_REBUILD",
      "PROVENANCE_INTEGRITY",
      "COLD_REPRODUCIBILITY",
      "LIVE_INTEGRATION_CALIBRATION_WHERE_APPLICABLE"
    ],
    "guard": "MORE_TESTS_ALONE_DO_NOT_PROVE_A_STRONGER_ENGINE"
  },
  "promotion_evidence_minimums": {
    "PROJECT": {
      "required": ["CORRECT_AUTHORITY", "BOUNDED_PILOT_OR_REAL_PROJECT_EVIDENCE", "NO_UNRESOLVED_FATAL_MAJOR", "APPLICATION_READBACK"]
    },
    "DOMAIN": {
      "required": ["PROJECT_NEUTRAL_ABSTRACTION", "EVIDENCE_OF_REUSE_OR_RECURRING_PROBLEM", "DOMAIN_PILOT_OR_MULTIPLE_COMPATIBLE_PROJECT_EVIDENCE", "NO_UNRESOLVED_FATAL_MAJOR", "APPLICATION_READBACK"]
    },
    "UNIVERSAL": {
      "required": ["GENERAL_PROBLEM_CLASS", "SEMANTIC_DEDUPE", "MULTI_PROJECT_OR_CROSS_DOMAIN_SUPPORT_WHERE_REASONABLE", "ADVERSARIAL_REVIEW", "REGRESSION_CHECK", "ROLLBACK_PATH", "NO_HIGHER_AUTHORITY_CONFLICT", "APPLICATION_READBACK"]
    }
  },
  "confidence_update_law": {
    "increase": ["INDEPENDENT_REPLICATION", "REAL_PROJECT_SUCCESS", "REAL_PROVIDER_SUCCESS", "REAL_HUMAN_OR_MARKET_EVIDENCE_WHEN_RELEVANT", "REPEATED_DEFECT_PREVENTION"],
    "decrease": ["NEW_FATAL_MAJOR", "FAILED_REPLICATION", "UNEXPECTED_COLLATERAL_REGRESSION", "REAL_HUMAN_MARKET_CONTRADICTION", "PROVIDER_REALITY_CONTRADICTS_DRY_RUN", "BETTER_SUPERSEDING_MECHANISM"]
  },
  "decision_outputs": ["PROMOTE", "PROMOTE_WITH_SCOPE_LIMIT", "KEEP_CURRENT", "PILOT_MORE", "HOLD_WITH_TRIGGER", "ROLLBACK", "SUPERSEDE", "REJECT"]
}
