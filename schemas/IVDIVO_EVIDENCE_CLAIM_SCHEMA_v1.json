{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.evidence_claim/1.0",
  "title": "IVDIVO Evidence Claim Envelope",
  "description": "Evidence metadata for gates/results. This envelope does not make a claim true; it prevents category collapse and unsupported PASS promotion.",
  "type": "object",
  "required": [
    "claim_id",
    "claim",
    "result",
    "evidence_class",
    "evidence_source",
    "verification_method",
    "what_this_evidence_can_prove",
    "what_this_evidence_cannot_prove"
  ],
  "properties": {
    "claim_id": {"type":"string","minLength":1},
    "claim": {"type":"string","minLength":1},
    "result": {"type":"string","enum":["PASS","FAIL","BLOCKED","PARTIAL","UNKNOWN","NOT_APPLICABLE","HOLD"]},
    "evidence_class": {
      "type":"string",
      "enum":[
        "AUTHORITY_FACT",
        "SOURCE_TEXT_FACT",
        "STATIC_INSPECTION",
        "AUTOMATED_TEST",
        "RUNTIME_EXECUTION",
        "PROVIDER_LIVE_OUTPUT",
        "OBJECTIVE_MEDIA_MEASUREMENT",
        "HUMAN_EXPERT_REVIEW",
        "HUMAN_TARGET_AUDIENCE_SIGNAL",
        "MARKET_BEHAVIOR",
        "MODEL_REVIEW",
        "INFERENCE",
        "HYPOTHESIS"
      ]
    },
    "evidence_source": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "required":["source_type","locator"],
        "properties": {
          "source_type":{"type":"string"},
          "locator":{"type":"string","minLength":1},
          "version":{"type":["string","null"]},
          "sha256":{"type":["string","null"]},
          "date":{"type":["string","null"]}
        },
        "additionalProperties":true
      }
    },
    "verification_method": {"type":"string","minLength":1},
    "what_this_evidence_can_prove": {"type":"array","minItems":1,"items":{"type":"string"}},
    "what_this_evidence_cannot_prove": {"type":"array","minItems":1,"items":{"type":"string"}},
    "required_evidence_class_for_claim": {"type":["string","null"]},
    "promotion_allowed": {"type":"boolean"},
    "notes": {"type":["string","null"]}
  },
  "additionalProperties":true
}
