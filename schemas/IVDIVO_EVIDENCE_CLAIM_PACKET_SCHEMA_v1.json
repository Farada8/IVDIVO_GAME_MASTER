{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IVDIVO_EVIDENCE_CLAIM_PACKET_SCHEMA_v1",
  "title": "IVDIVO Evidence Claim Packet",
  "type": "object",
  "required": ["claims", "evidence"],
  "$defs": {
    "evidenceClass": {
      "enum": [
        "DETERMINISTIC_MACHINE",
        "INTERNAL_AI_REVIEW",
        "SOURCE_PROVENANCE",
        "PRODUCTION_OBSERVATION",
        "PROVIDER",
        "HUMAN_SIGNAL",
        "SPECIALIST",
        "MARKET",
        "FOUNDER_AUTHORITY"
      ]
    }
  },
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_text", "required_evidence_classes"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_text": {"type": "string", "minLength": 1},
          "required_evidence_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidenceClass"}
          },
          "minimum_independent_source_families": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "evidence_class", "source_locator", "source_family", "status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_class": {"$ref": "#/$defs/evidenceClass"},
          "source_locator": {"type": "string", "minLength": 1},
          "source_family": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "HOLD", "BLOCKED"]}
        }
      }
    }
  },
  "additionalProperties": true
}
