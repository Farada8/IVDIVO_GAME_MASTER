{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"ivdivo.problem_targeted_reference_queue/1.0",
  "title":"IVDIVO Problem-Targeted Reference Queue",
  "type":"object",
  "required":["decision_or_problem","current_evidence","sources","stopping_rule"],
  "properties":{
    "decision_or_problem":{"type":"string"},
    "current_evidence":{"type":"array","items":{"type":"string"}},
    "sources":{"type":"array","items":{"type":"object","required":["source_id","lifecycle_status","specific_question_it_can_change","expected_information_value","cost","application_target","stop_after"],"properties":{
      "source_id":{"type":"string"},
      "lifecycle_status":{"type":"string","enum":["UNSYNTHESIZED","INTEGRITY_BLOCKED","PARTIALLY_SYNTHESIZED","SYNTHESIZED","REFERENCE_ONLY"]},
      "specific_question_it_can_change":{"type":"string"},
      "expected_information_value":{"type":"string","enum":["HIGH","MEDIUM","LOW","NONE"]},
      "cost":{"type":"string"},
      "application_target":{"type":"string"},
      "stop_after":{"type":"string"}
    }}}
    ,"stopping_rule":{"type":"array","minItems":1,"items":{"type":"string"}},
    "next_more_informative_action":{"type":"string"}
  }
}
