{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "IVDIVO_AUTHORITY_FRESHNESS_SNAPSHOT_SCHEMA_v1",
  "title": "IVDIVO Authority Freshness Snapshot",
  "type": "object",
  "required": ["project_id", "sources"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_key", "locator", "authority_rank", "disposition"],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "revision": {"type": ["string", "null"]},
          "modified_at": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "authority_rank": {"type": "integer"},
          "disposition": {"enum": ["CURRENT", "SUPERSEDED", "HISTORICAL", "REFERENCE_ONLY"]},
          "supersedes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  },
  "additionalProperties": true
}
