{
  "schema_version": "ivdivo.room917_ru_s0_listen_gate/1.0",
  "date": "2026-08-22",
  "status": "HUMAN_LISTEN_REQUIRED",
  "purpose": "Decide whether the Russian voices feel like believable people before any full E01 render.",
  "source_bundle": "ROOM917_RU_S0_CANARY_BLOCK_BUNDLE_v1.0.json",
  "artifact_expected": "ROOM917_RU_S0_CANARY",
  "hard_fail_any": [
    "OBVIOUS_AI_TELL_IN_CRITICAL_LINE",
    "TRAILER_OR_ALPHA_JULIAN",
    "AUDIOBOOK_OR_HORROR_ELENA",
    "COMIC_SIDEKICK_MINA",
    "GHOST_OR_MELODRAMATIC_CATE",
    "BROKEN_RUSSIAN_PRONUNCIATION",
    "LENI_BIRD_NOT_LEXICALLY_CLEAR",
    "PAIR_CHEMISTRY_FEELS_SYNTHETIC_OR_TURN_BASED",
    "CHARACTER_AGE_OR_SOCIAL_STATUS_FEELS_WRONG"
  ],
  "roles": {
    "ELENA": {
      "must_feel": ["working professional", "precise", "dry intelligence", "emotion under control", "not horror narrator"],
      "reject_if": ["announcer", "audiobook declamation", "cold robot", "mystical foreknowledge", "overacted sarcasm"]
    },
    "JULIAN": {
      "must_feel": ["36-year-old operational responsibility", "restrained pressure", "credible hotel authority", "human not archetype"],
      "reject_if": ["alpha growl", "romance trailer voice", "villain foreshadowing", "too old", "too polished to be tired"]
    },
    "MINA": {
      "must_feel": ["ordinary competent hotel worker", "socially quick", "warm", "humor without performing jokes"],
      "reject_if": ["sitcom sidekick", "childish", "hyperactive", "exposition voice"]
    },
    "CATE": {
      "must_feel": ["ordinary mother", "tired human", "same plausible woman for E01 line and E02 cassette"],
      "reject_if": ["ghost", "whisper actress", "melodramatic plea", "different identity between media"]
    }
  },
  "pair_tests": {
    "RU_S0_ELENA_MINA_RELATION": {
      "pass_if": ["interruptible human rhythm", "no instant-best-friend acting", "Mina humor lands without comic pause", "Elena remains occupied by work"]
    },
    "RU_S0_ELENA_JULIAN_FRICTION": {
      "pass_if": ["both positions remain credible", "status conflict without villain/hero coding", "no overt flirt", "no synthetic equal-turn cadence"]
    }
  },
  "scoring": {
    "scale": "0-5",
    "dimensions": [
      "BELIEVABILITY",
      "RUSSIAN_NATURALNESS",
      "CHARACTER_FIT",
      "SUBTEXT",
      "MICRO_RHYTHM",
      "PAIR_COMPATIBILITY",
      "NO_AI_TELL"
    ],
    "minimum_each_dimension": 4,
    "no_hard_fail": true,
    "cast_lock_rule": "PASS_ALL_ROLE_CANARIES_AND_PAIR_TESTS_OR_REPLACE_ONLY_FAILED_VOICE_BLOCKS"
  },
  "founder_fast_gate": [
    "Верю ли я, что это живой человек?",
    "Верю ли я, что он или она сейчас реально занят этой работой, а не читает текст?",
    "Слышу ли я типичный голос ИИ?",
    "Хочу ли я слушать этих людей ещё десять минут?"
  ],
  "outcomes": {
    "PASS": "Lock current selected voice only after provider identity is confirmed; proceed to controlled E01 dialogue blocks.",
    "REPAIR": "Change settings or rerender only the failed canary block; do not rerender passed material.",
    "RECAST": "Replace only the failed character voice and rerun that character plus affected pair tests.",
    "STOP": "Do not render full E01. Revisit casting/performance direction first."
  }
}
