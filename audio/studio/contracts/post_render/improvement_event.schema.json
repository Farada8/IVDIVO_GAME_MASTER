{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.self_improvement.post_render_event/1.0",
  "title": "IVDIVO Post-Render Self-Improvement Event",
  "type": "object",
  "required": ["event_id", "project_id", "mechanism_id", "problem_class", "earliest_failure_layer", "evidence_refs", "candidate_delta", "regression_results", "metrics", "synthetic_only", "event_hash"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "mechanism_id": {"type": "string", "minLength": 1},
    "problem_class": {"type": "string", "minLength": 1},
    "earliest_failure_layer": {"type": "string", "minLength": 1},
    "candidate_delta": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1},
    "regression_results": {"type": "array", "minItems": 1},
    "metrics": {"type": "object"},
    "synthetic_only": {"type": "boolean"},
    "promotion_claim": {"const": "NONE"},
    "event_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": true,
  "x-ivdivo-law": "A project event may propose a reusable mechanism; it may not promote itself or export project story facts into universal rules."
}
