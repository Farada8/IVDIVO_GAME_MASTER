{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.audio.post_render.patch_authorization/1.0",
  "title": "IVDIVO Post-Render Patch Authorization",
  "type": "object",
  "required": ["patch_id", "status", "source_master_sha256", "authorization_hash", "interval", "asset_binding_hash", "lineage_hash"],
  "properties": {
    "patch_id": {"type": "string", "minLength": 1},
    "status": {"const": "AUTHORIZED"},
    "source_master_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "asset_binding_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "lineage_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "interval": {"$ref": "canonical_interval.schema.json"},
    "headroom_gate": {"enum": ["PASS"]},
    "protected_timing_complete": {"const": true},
    "bed_domain_count": {"const": 1}
  },
  "additionalProperties": true,
  "x-ivdivo-law": "Classifier may nominate a candidate. Only an authorization artifact that binds master identity, exact timing, protected ranges, asset provenance and headroom may authorize bytes to change."
}
