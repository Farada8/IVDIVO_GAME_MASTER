{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.audio.live_evidence_escrow/1.1",
  "title": "IVDIVO Live Provider Evidence Escrow",
  "type": "object",
  "required": ["schema_version", "status", "expected_source_sha256", "expected_block_ids", "lineage_count", "issues", "lineages", "provider_acceptance_is_not_take_acceptance", "auto_retry_allowed", "machine_may_replay_paid_request", "escrow_sha256"],
  "properties": {
    "schema_version": {"const": "ivdivo.audio.live_evidence_escrow/1.1"},
    "status": {"enum": ["PASS_EXACT_ESCROW", "HOLD"]},
    "expected_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_block_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lineage_count": {"type": "integer", "minimum": 0},
    "issues": {"type": "object"},
    "lineages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema_version", "block_id", "source_sha256", "request_hash", "provider_state", "spend_ledger_state", "request_ref", "spend_ledger_ref", "capability_snapshot_sha256", "production_take_status", "take_lock", "secret_persisted", "lineage_sha256"],
        "properties": {
          "schema_version": {"const": "ivdivo.audio.live_evidence_lineage/1.1"},
          "provider_state": {"enum": ["ACCEPTED", "REJECTED", "AMBIGUOUS"]},
          "spend_ledger_state": {"enum": ["ACCEPTED", "REJECTED", "AMBIGUOUS"]},
          "request_ref": {"type": "string", "minLength": 1},
          "spend_ledger_ref": {"type": "string", "minLength": 1},
          "production_take_status": {"const": "NOT_ACCEPTED"},
          "take_lock": {"const": false},
          "secret_persisted": {"const": false}
        }
      }
    },
    "provider_acceptance_is_not_take_acceptance": {"const": true},
    "auto_retry_allowed": {"const": false},
    "machine_may_replay_paid_request": {"const": false},
    "escrow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true,
  "x-ivdivo-law": "Provider state must match spend-ledger state. Request/spend refs are mandatory; accepted media also requires durable response/audio evidence. Exact expected lineages only; ambiguity/duplicates/drift => HOLD; recovery never replays paid requests."
}
