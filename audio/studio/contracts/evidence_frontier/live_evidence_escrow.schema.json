{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.audio.live_evidence_escrow/1.0",
  "title": "IVDIVO Live Provider Evidence Escrow",
  "type": "object",
  "required": ["schema_version", "status", "expected_source_sha256", "expected_block_ids", "lineage_count", "issues", "lineages", "provider_acceptance_is_not_take_acceptance", "auto_retry_allowed", "machine_may_replay_paid_request", "escrow_sha256"],
  "properties": {
    "schema_version": {"const": "ivdivo.audio.live_evidence_escrow/1.0"},
    "status": {"enum": ["PASS_EXACT_ESCROW", "HOLD"]},
    "expected_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_block_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lineage_count": {"type": "integer", "minimum": 0},
    "issues": {"type": "object"},
    "lineages": {"type": "array"},
    "provider_acceptance_is_not_take_acceptance": {"const": true},
    "auto_retry_allowed": {"const": false},
    "machine_may_replay_paid_request": {"const": false},
    "escrow_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true,
  "x-ivdivo-law": "Exact expected lineages only. Unknown fourth lineage, duplicate block/request, ambiguous provider state, source/request drift or missing durable accepted-media evidence => HOLD. Recovery reads persisted evidence; it never replays paid requests."
}
