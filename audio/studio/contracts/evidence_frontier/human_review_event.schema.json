{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.audio.human_review_event/1.1",
  "title": "IVDIVO Human Review Evidence Event",
  "type": "object",
  "required": ["schema_version", "candidate_id", "role_id", "candidate_binding_sha256", "evidence_family", "reviewer_type", "reviewer_ref", "artifact_sha256", "source_sha256", "reviewed_at", "decision", "scores", "hard_fails", "machine_generated", "event_sha256"],
  "properties": {
    "schema_version": {"const": "ivdivo.audio.human_review_event/1.1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "candidate_binding_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_family": {"enum": ["PRONUNCIATION", "MULTI_STATE", "PAIR", "FATIGUE", "BLIND_LISTEN", "TECHNICAL_QC"]},
    "reviewer_type": {"enum": ["HUMAN_LISTENER", "HUMAN_DIRECTOR", "LANGUAGE_REVIEWER", "AUDIO_ENGINEER", "FOUNDER"]},
    "reviewer_ref": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewed_at": {"type": "string", "minLength": 1},
    "decision": {"enum": ["PASS", "FAIL", "HOLD"]},
    "scores": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 5}},
    "hard_fails": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "machine_generated": {"const": false},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true,
  "x-ivdivo-law": "Review evidence is bound to an exact candidate voice/model/settings binding. Different binding revisions may not be silently combined. Complete evidence creates only eligibility for authorized human/Founder lock; machine auto-lock is forbidden."
}
