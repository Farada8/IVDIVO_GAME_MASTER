{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ivdivo.audio.proof_manifest/1.2",
  "title": "IVDIVO Audio Evidence-Class Manifest",
  "type": "object",
  "required": ["schema_version", "claim", "subject", "required_evidence_classes", "verified_evidence_classes", "missing_evidence_classes", "status", "claim_externally_proven_by_this_module", "evidence", "machine_may_upgrade_claim_without_required_evidence", "proof_sha256"],
  "properties": {
    "schema_version": {"const": "ivdivo.audio.proof_manifest/1.2"},
    "claim": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "status": {"enum": ["EVIDENCE_CLASS_COMPLETE", "HOLD_UNPROVEN"]},
    "required_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"enum": ["SOURCE_AUTHORITY", "CODE_TEST", "GITHUB_CI", "AUTH_PROVIDER", "LIVE_AUDIO", "REAL_ALIGNMENT", "HUMAN_REVIEW", "MEASURED_ECONOMICS", "DURABLE_RECOVERY", "CROSS_PROJECT_REAL"]}},
    "verified_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "missing_evidence_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "claim_externally_proven_by_this_module": {"const": false},
    "evidence": {"type": "array"},
    "machine_may_upgrade_claim_without_required_evidence": {"const": false},
    "proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true,
  "x-ivdivo-law": "This manifest proves only evidence-class completeness and integrity. It does not independently fetch or prove external provider, human, live-audio, alignment, recovery, economics or cross-project facts. PASS_CODE cannot prove provider reality; provider auth cannot prove live audio; live audio cannot prove alignment; human preference cannot prove measured cost; a successful run cannot prove durable recovery or cross-project portability."
}
